# =============================================================
# COPO - Environment Variable Template
# Copy this file to .env and fill in real values
# =============================================================

SPRING_PROFILES_ACTIVE=prod
PORT=9091

# Database
DATABASE_URL=jdbc:mysql://<DB_HOST>:3306/copo3?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<STRONG_PASSWORD>

# Session Secret
SESSION_SECRET=<RANDOM_HEX_32>

# Logging
LOG_LEVEL=WARN
